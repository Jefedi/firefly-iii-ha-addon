#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Firefly III — Service web (php-fpm + nginx)
# ==============================================================================

set -e

FIREFLY_DIR="/var/www/html"
cd "${FIREFLY_DIR}"

# Démarrer php-fpm en arrière-plan
php-fpm -D

# Démarrer nginx au premier plan (le processus principal du conteneur)
exec nginx -g 'daemon off;'